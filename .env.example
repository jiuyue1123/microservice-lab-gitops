# Application environment for microservice-lab.
# Copy to .env and adjust. The real .env is gitignored.
#
# Common variables are injected into both user-service and gateway.
# DB_ variables are injected into user-service only.

NACOS_SERVER_ADDR=nacos.microservice-lab-platform.svc:8848
NACOS_NAMESPACE=microservice-lab
NACOS_GROUP=DEFAULT_GROUP
NACOS_USERNAME=mslab
NACOS_PASSWORD=CHANGE_ME

JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -Duser.timezone=Asia/Shanghai
TZ=Asia/Shanghai
SPRING_PROFILES_ACTIVE=default

DB_HOST=mysql-user.microservice-lab-platform.svc.cluster.local
DB_PORT=3306
DB_NAME=user_db
DB_USERNAME=user
DB_PASSWORD=CHANGE_ME
